  <owl:DeprecatedProperty rdf:ID="inXSDDateTime">
    <rdfs:label xml:lang="es">en fecha-tiempo XSD</rdfs:label>
    <rdfs:label xml:lang="en">in XSD Date-Time</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <skos:definition xml:lang="es">Posición de un instante, expresado utilizando xsd:dateTime.</skos:definition>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <rdfs:domain rdf:resource="#Instant"/>
    <skos:note xml:lang="es">La propiedad 'en fecha-hora XSD' ha sido reemplazada por 'en fecha-sello de tiempo XSD' que hace obligatorio el campo 'huso horario'.</skos:note>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:definition xml:lang="en">Position of an instant, expressed using xsd:dateTime</skos:definition>
    <skos:note xml:lang="en">The property :inXSDDateTime is replaced by :inXSDDateTimeStamp which makes the time-zone field mandatory.</skos:note>
  </owl:DeprecatedProperty>
  <owl:DeprecatedClass rdf:ID="Year">
    <skos:prefLabel xml:lang="pt">Ano</skos:prefLabel>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <skos:prefLabel xml:lang="it">Anno</skos:prefLabel>
    <skos:prefLabel xml:lang="ar">سنة</skos:prefLabel>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="#years"/>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
        >1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <skos:prefLabel xml:lang="pl">Rok</skos:prefLabel>
    <rdfs:label xml:lang="en">Year</rdfs:label>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="#months"/>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
        >0</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <skos:prefLabel xml:lang="nl">Jaar</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="#DurationDescription"/>
    <skos:definition>Year duration</skos:definition>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="#weeks"/>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
        >0</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <skos:prefLabel xml:lang="es">Año</skos:prefLabel>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="#minutes"/>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
        >0</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="de">Jahr</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Année (calendrier)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Year</skos:prefLabel>
    <skos:historyNote>Year was proposed in the 2006 version of OWL-Time as an example of how DurationDescription could be specialized to allow for a duration to be restricted to a number of years. &#xD;
&#xD;
It is deprecated in this edition of OWL-Time. </skos:historyNote>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="#hours"/>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
        >0</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <skos:prefLabel xml:lang="ru">Год</skos:prefLabel>
    <skos:prefLabel xml:lang="zh">年</skos:prefLabel>
    <skos:prefLabel xml:lang="ja">年</skos:prefLabel>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="#seconds"/>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
        >0</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="#days"/>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
        >0</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:DeprecatedClass>
